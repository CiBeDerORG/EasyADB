EASYADB_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN
# Keep localhost by default; for trusted EasyTier/LAN access set your NAS interface IP.
EASYADB_BIND_IP=127.0.0.1
EASYADB_PORT=8765

# Mihomo must be on the existing proxy-net with Docker hostname "mihomo".
# Used for builds (not ADB traffic). The helper script uses the same default.
# The Docker daemon's initial BuildKit image pull remains a separate prerequisite.
EASYADB_BUILD_PROXY=http://mihomo:7890
