EASYADB_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN
# Keep localhost by default; for trusted EasyTier/LAN access set your NAS interface IP.
EASYADB_BIND_IP=127.0.0.1
EASYADB_PORT=8765

# Optional for manual builds only. Recommended: leave blank and run:
#   sh scripts/build-with-mihomo.sh
# The script uses a dedicated proxy-net Buildx builder and automatically
# discovers Mihomo's proxy-net IPv4 (avoids BuildKit custom DNS issues).
# The Python FROM image is pulled separately by Docker/BuildKit.
EASYADB_BUILD_PROXY=
