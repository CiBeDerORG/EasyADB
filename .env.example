EASYADB_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN
# Keep localhost by default; for trusted EasyTier/LAN access set your NAS interface IP.
EASYADB_BIND_IP=127.0.0.1
EASYADB_PORT=8765

# Build-time download proxy for apt/curl/pip, e.g. http://<mihomo proxy-net IP>:7890.
# Recommended: leave blank and use 'sh scripts/build-with-mihomo.sh' to resolve IP automatically.
# This does NOT configure the Docker daemon's FROM / docker pull proxy.
EASYADB_BUILD_PROXY=
