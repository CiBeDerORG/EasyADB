EASYADB_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN
# Keep localhost by default; for trusted EasyTier/LAN access set your NAS interface IP.
EASYADB_BIND_IP=127.0.0.1
EASYADB_PORT=8765

# Build/BuildKit proxy on the existing proxy-net.
# If Mihomo requires a password, use:
# EASYADB_BUILD_PROXY=http://USER:URL_ENCODED_PASSWORD@mihomo:7890
# For example, a password 'abc@mihomo' becomes 'abc%40mihomo'.
# Do not commit the real .env or share its contents.
EASYADB_BUILD_PROXY=http://mihomo:7890
