#!/bin/sh
# Local-only mDNS scan helper; RPCD/LuCI decides who may invoke it.
# No HTTP listener, remote destination or arbitrary arguments.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
STATE=/tmp/luci-avahi-web
SNAPSHOT=$STATE/last-scan.json
LOCK=$STATE/scan.lock
SERVICE=_adb-tls-connect._tcp

fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "$#" -eq 1 ] || fail 'Expected one fixed action'
case "$1" in
    scan|last) action=$1 ;;
    *) fail 'Unsupported scan action' ;;
esac
umask 077
[ ! -L "$STATE" ] || fail 'Unsafe scan state symlink'
if [ ! -e "$STATE" ]; then
    mkdir -m 0700 "$STATE" || fail 'Cannot create state directory'
fi
[ -d "$STATE" ] && [ ! -L "$STATE" ] || fail 'Unsafe state path'
[ "$(stat -c '%u' "$STATE" 2>/dev/null)" = 0 ] || fail 'Scan state directory is not root-owned'
chmod 0700 "$STATE"
case "$action" in
    last)
        [ -r "$SNAPSHOT" ] || fail 'No scan snapshot yet'
        cat "$SNAPSHOT"
        exit 0 ;;
esac
[ -x /usr/bin/avahi-browse ] || fail 'avahi-utils not installed'
pidof avahi-daemon >/dev/null 2>&1 || fail 'Avahi is not running'
[ -r /usr/share/libubox/jshn.sh ] || fail 'libubox jshn missing'
if ! mkdir "$LOCK" 2>/dev/null; then
    fail 'Scan already running; retry after completion'
fi
RAW="$STATE/.browse.$$"
TABLE="$STATE/.records.$$"
OUT="$STATE/.snapshot.$$"
trap 'rm -f "$RAW" "$TABLE" "$OUT"; rmdir "$LOCK" 2>/dev/null || true' EXIT HUP INT TERM
rc=0
timeout 8 avahi-browse -rpt "$SERVICE" > "$RAW" 2>/dev/null || rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ]; then
    fail 'Avahi browse failed'
fi
# Parse Avahi's parseable semicolon format, retaining escaped \; within fields.
# Use ASCII record separator between our seven fields (not a shell delimiter).
awk '
function split_record(s,a,   i,c,n) {
    n=1; a[n]=""
    for(i=1;i<=length(s);i++) {
        c=substr(s,i,1)
        if(c=="\\" && i<length(s)) {
            a[n]=a[n] c substr(s,++i,1)
        } else if(c==";") {
            n++; a[n]=""
        } else a[n]=a[n] c
    }
    return n
}
{
    n=split_record($0,f)
    if(n<9 || f[1]!="=" || f[5]!="_adb-tls-connect._tcp") next
    if(f[9] !~ /^[0-9]+$/ || f[9]+0<1 || f[9]+0>65535) next
    if(length(f[8])>128 || length(f[4])>256) next
    # Avoid injecting field delimiters or newlines into the intermediate file.
    for (j=2;j<=9;j++) gsub(/\034/,"",f[j])
    key=f[2] SUBSEP f[3] SUBSEP f[4] SUBSEP f[8] SUBSEP f[9]
    if(seen[key]++) next
    printf "%s%c%s%c%s%c%s%c%s%c%s%c%s\n", f[2],28,f[3],28,f[4],28,f[5],28,f[7],28,f[8],28,f[9]
    count++
    if(count>=32) exit
}' "$RAW" > "$TABLE"
# libubox JSON encoder handles escaping; never build JSON with shell interpolation.
. /usr/share/libubox/jshn.sh
json_init
json_add_string status ok
json_add_string source avahi
json_add_int scanned_at "$(date +%s)"
json_add_array devices
count=0
sep="$(printf '\034')"
while IFS="$sep" read -r iface proto name type host ip port; do
    [ -n "$port" ] || continue
    json_add_object ""
    json_add_string iface "$iface"
    json_add_string protocol "$proto"
    json_add_string instance "$name"
    json_add_string service "$type"
    json_add_string host "$host"
    json_add_string address "$ip"
    json_add_int port "$port"
    json_close_object
    count=$((count + 1))
done < "$TABLE"
json_close_array
json_add_int count "$count"
json_add_string storage volatile
json_dump > "$OUT"
chmod 0600 "$OUT"
mv "$OUT" "$SNAPSHOT"
cat "$SNAPSHOT"
