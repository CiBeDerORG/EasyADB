#!/bin/sh
# Fixed-command LuCI backend. Never evaluate or source user-supplied values.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
INIT=/etc/init.d/avahi-daemon
APK=$(command -v apk || true)

fail() { printf '%s\n' "$*" >&2; exit 1; }
need_no_args() { [ "$#" -eq 0 ] || fail '存在多余的参数'; }
installed() { [ -x /usr/sbin/avahi-daemon ] && [ -x /usr/bin/avahi-browse ]; }
flag() { if "$@" >/dev/null 2>&1; then printf 'yes'; else printf 'no'; fi; }
binary_flag() { if command -v "$1" >/dev/null 2>&1; then printf 'yes'; else printf 'no'; fi; }
unit_flag() { if [ -x "/etc/init.d/$1" ]; then printf 'yes'; else printf 'no'; fi; }
running() { pidof avahi-daemon >/dev/null 2>&1; }
umdns_running() { pidof umdns >/dev/null 2>&1; }

service_action() {
    [ "$#" -eq 1 ] || fail '服务操作参数无效'
    case "$1" in
        start|stop|enable|disable)
            op=$1; init=$INIT; unit=avahi ;;
        umdns-start|umdns-stop|umdns-enable|umdns-disable)
            op=${1#umdns-}; init=/etc/init.d/umdns; unit=umdns ;;
        dbus-start)
            op=start; init=/etc/init.d/dbus; unit=dbus ;;
        *) fail '不支持的服务操作' ;;
    esac
    [ -x "$init" ] || fail '缺少对应服务的启动脚本，请先确认软件包已安装完整'
    if [ "$op" = enable ]; then
        if [ "$unit" = avahi ] && [ -x /etc/init.d/umdns ] &&
            /etc/init.d/umdns enabled >/dev/null 2>&1; then
            fail 'umdns 已启用开机自启，请先关闭其自启再启用 Avahi 自启'
        fi
        if [ "$unit" = umdns ] && [ -x "$INIT" ] &&
            "$INIT" enabled >/dev/null 2>&1; then
            fail 'Avahi 已启用开机自启，请先关闭其自启再启用 umdns 自启'
        fi
    fi
    if [ "$op" = start ] && [ "$unit" = avahi ] &&
        ! pidof dbus-daemon >/dev/null 2>&1; then
        fail 'D-Bus 未运行，请先启动 D-Bus 后再启动 Avahi'
    fi
    if [ "$op" = start ]; then
        if [ "$unit" = avahi ] && umdns_running; then
            fail '检测到 umdns 正在运行，请先停止 umdns，再启动 Avahi，以避免 mDNS 服务冲突'
        fi
        if [ "$unit" = umdns ] && running; then
            fail '检测到 Avahi 正在运行，请先停止 Avahi，再启动 umdns，以避免 mDNS 服务冲突'
        fi
    fi
    "$init" "$op"
}
# Package operations are APK-only and restricted to exactly three managed
# components. No arguments, URLs, options, shell expressions or force flags
# supplied by the browser may reach the package manager.
require_apk() {
    [ -n "$APK" ] && [ -x "$APK" ] || fail '找不到 APK 软件包管理器'
}

package_names() {
    case "$1" in
        avahi) set -- avahi-dbus-daemon avahi-utils ;;
        dbus) set -- dbus ;;
        umdns) set -- umdns ;;
        *) fail '不支持的软件包组件' ;;
    esac
    printf '%s\n' "$@"
}

package_list() {
    need_no_args "$@"
    require_apk
    for pkg in avahi-dbus-daemon avahi-utils dbus umdns; do
        if "$APK" info -e "$pkg" >/dev/null 2>&1; then
            # This is display-only; never shell-evaluate the version.
            version=$("$APK" info -v "$pkg" 2>/dev/null | sed -n '1p' || true)
            printf '%s\tinstalled\t%s\n' "$pkg" "$version"
        else
            printf '%s\tabsent\t-\n' "$pkg"
        fi
    done
}

package_verb() {
    case "$1" in
        install) printf 'add' ;;
        remove) printf 'del' ;;
        upgrade) printf 'upgrade' ;;
        *) fail '不支持的软件包操作' ;;
    esac
}

package_operation() {
    phase=$1; shift
    [ "$#" -eq 2 ] || fail '软件包操作参数不完整'
    action=$1; target=$2
    require_apk
    verb=$(package_verb "$action")
    names=$(package_names "$target")
    # Package names are fixed literals emitted by package_names; disable globbing
    # and split only its newline-separated tokens to build the argument vector.
    set -f
    oldIFS=$IFS; IFS='
'
    set -- $names
    IFS=$oldIFS
    set +f
    # If only avahi-utils is missing, install that tool without touching the
    # already installed daemon. This does not start or reconfigure an mDNS server.
    utility_only=no
    if [ "$action" = install ] && [ "$target" = avahi ] &&
       "$APK" info -e avahi-dbus-daemon >/dev/null 2>&1 &&
       ! "$APK" info -e avahi-utils >/dev/null 2>&1; then
        set -- avahi-utils
        utility_only=yes
    fi
    if [ "$action" != remove ]; then
        # New daemon installs/upgrades can activate services through maintainer
        # scripts; only the isolated utility repair is exempt.
        if [ "$target" = avahi ] && [ "$utility_only" != yes ] && umdns_running; then
            fail '检测到 umdns 正在运行：安装或更新 Avahi 前请先停止 umdns'
        fi
        if [ "$target" = umdns ] && running; then
            fail '检测到 Avahi 正在运行：安装或更新 umdns 前请先停止 Avahi'
        fi
    fi
    if [ "$action" = remove ]; then
        # Do not let the UI remove an actively operating mDNS daemon, or pull
        # D-Bus from a live Avahi session. The operator must stop it first.
        if [ "$target" = umdns ] && umdns_running; then
            fail 'umdns 正在运行，请先停止后再卸载'
        fi
        if [ "$target" = avahi ] && running; then
            fail 'Avahi 正在运行，请先停止后再卸载'
        fi
        if [ "$target" = dbus ] && pidof dbus-daemon >/dev/null 2>&1; then
            fail 'D-Bus 正在运行，请先处理依赖它的服务后再卸载'
        fi
    fi
    if [ "$phase" = plan ]; then
        "$APK" --simulate "$verb" "$@"
    elif [ "$phase" = apply ]; then
        # apk's dependency solver remains authoritative: no -r, --force,
        # --allow-untrusted, or blanket system upgrade.
        "$APK" "$verb" "$@"
    else
        fail '不支持的软件包执行阶段'
    fi
}

package_action() {
    [ "$#" -ge 1 ] || fail '缺少软件包操作'
    sub=$1; shift
    case "$sub" in
        list) package_list "$@" ;;
        plan) package_operation plan "$@" ;;
        apply) package_operation apply "$@" ;;
        refresh)
            need_no_args "$@"
            require_apk
            "$APK" update ;;
        *) fail '不支持的软件包命令' ;;
    esac
}

[ "$#" -gt 0 ] || fail '缺少操作参数'
cmd=$1; shift
case "$cmd" in
    status)
        need_no_args "$@"
        installed && printf 'installed=yes\n' || printf 'installed=no\n'
        running && printf 'running=yes\n' || printf 'running=no\n'
        umdns_running && printf 'umdns=yes\n' || printf 'umdns=no\n'
        pidof dbus-daemon >/dev/null 2>&1 && printf 'dbus=yes\n' || printf 'dbus=no\n'
        printf 'avahi-daemon-bin=%s\n' "$(flag test -x /usr/sbin/avahi-daemon)"
        printf 'avahi-browse-bin=%s\n' "$(flag test -x /usr/bin/avahi-browse)"
        printf 'umdns-bin=%s\n' "$(binary_flag umdns)"
        printf 'dbus-bin=%s\n' "$(binary_flag dbus-daemon)"
        for unit in avahi-daemon umdns dbus; do
            printf '%s-init=%s\n' "$unit" "$(unit_flag "$unit")"
        done
        for unit in avahi-daemon umdns dbus; do
            [ -x "/etc/init.d/$unit" ] || continue
            if "/etc/init.d/$unit" enabled >/dev/null 2>&1; then
                printf '%s-enabled=yes\n' "$unit"
            else
                printf '%s-enabled=no\n' "$unit"
            fi
        done
        ;;
    service) service_action "$@" ;;
    package) package_action "$@" ;;
    *) fail '不支持的操作' ;;
esac
