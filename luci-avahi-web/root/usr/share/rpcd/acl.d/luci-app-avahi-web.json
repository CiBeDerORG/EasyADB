{
  "luci-app-avahi-web": {
    "description": "Manage Avahi and browse local Android wireless debugging endpoints",
    "read": {
      "file": {
        "/usr/libexec/luci-avahi-web status": [
          "exec"
        ],
        "/usr/libexec/luci-avahi-web package list": [
          "exec"
        ],
        "/usr/libexec/luci-avahi-web package plan *": [
          "exec"
        ],
        "/usr/libexec/luci-avahi-scan last": [
          "exec"
        ]
      }
    },
    "write": {
      "file": {
        "/usr/libexec/luci-avahi-web service *": [
          "exec"
        ],
        "/usr/libexec/luci-avahi-web package apply *": [
          "exec"
        ],
        "/usr/libexec/luci-avahi-web package refresh": [
          "exec"
        ]
      }
    }
  },
  "luci-avahi-easyadb": {
    "description": "Minimal dedicated RPCD role: authenticate NAS, permit only one fixed Avahi scan command",
    "read": {
      "file": {
        "/usr/libexec/luci-avahi-scan scan": [
          "exec"
        ]
      }
    }
  }
}
